# Cloudflare reads this from the root of the served assets. Rules are
# CUMULATIVE — every matching rule contributes — so a catch-all that sets
# Cache-Control would append a second, conflicting directive to the hashed
# assets below. Only /_astro/* sets caching here; HTML keeps the platform
# default (public, max-age=0, must-revalidate), which is what we want anyway.

# Astro fingerprints everything in /_astro/ with a content hash, so a given
# URL's bytes never change — cache it hard and skip revalidation entirely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
