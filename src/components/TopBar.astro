---
/* The sticky top bar. `themePicker` adds the paint-roller toggle and the
   panel — only the showcase carries it; the event page and the lab are
   kraft-only surfaces.

   Below 56rem the inline nav gives way to a drawer (see NavDrawer.astro). The
   theme toggle deliberately does NOT go into the drawer: it is the point of
   this site, its panel is a full-width band under the bar rather than a nav
   item, and burying the one control everything else exists to demonstrate
   behind a hamburger would be the wrong trade. So the bar keeps two controls
   at small widths — theme, then menu. */
import ThemePicker from "./ThemePicker.astro";
import NavDrawer from "./NavDrawer.astro";

interface Props {
  links: { href: string; label: string; current?: boolean }[];
  brandHref?: string;
  themePicker?: boolean;
}
const { links, brandHref = "#top", themePicker } = Astro.props;
---

<header class="topbar">
  <div class="container topbar-row">
    <a class="brand" href={brandHref}>BLR<span> Hikes</span></a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={l.current ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="topbar-ctl">
      {themePicker && (
        <button class="tp-toggle" id="theme-toggle" aria-expanded="false" aria-controls="themepicker">
          <i class="fa-solid fa-paint-roller" aria-hidden="true"></i>
          Theme
        </button>
      )}
      <button
        class="nav-toggle"
        id="nav-toggle"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  {themePicker && <ThemePicker />}
</header>

<NavDrawer links={links} brandHref={brandHref} />
