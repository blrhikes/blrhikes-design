---
/* Before you ask — the folds at the bottom of the article. */
interface Props {
  items: { icon: string; q: string; a: string }[];
}
const { items } = Astro.props;
---

{items.map((f) => (
  <details class="ev-fold">
    <summary><i class={`fa-solid fa-${f.icon}`} aria-hidden="true"></i>{" "}{f.q}</summary>
    <div><p>{f.a}</p></div>
  </details>
))}
