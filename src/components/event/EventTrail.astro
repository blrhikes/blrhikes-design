---
/* The trail the hike follows, above the article. A TrailCardOverlay rather
   than a TrailCard: at the article's width the cover is big enough to carry
   the name and the fixed facts on it, which is exactly the density that
   variant was drawn for. */
import TrailCardOverlay from "../cards/TrailCardOverlay.astro";
import { emeraldFallsCircuit } from "../../data/trails.js";
---

<div class="ev-trail">
  <p class="ev-block-title ev-block-title--gap">We’re going here:</p>
  <div class="trail-grid trail-grid--wide">
    <TrailCardOverlay trail={emeraldFallsCircuit} />
  </div>
</div>
