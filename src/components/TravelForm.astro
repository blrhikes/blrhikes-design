---
/* TravelForm — the rider's half of the travel section: mode cards, the
   start/pickup pair, the vehicle + seats row, notes, one save button.

   Extracted from CarpoolSection (2026-08-08) so the APP can adopt it as a
   component — in blrhikes-app this wraps a real progressively-enhanced form;
   here it is the static exhibit. Every prop defaults to the showcase's own
   demo content, so the extraction changed nothing on the page. */
import Field from "./ui/Field.astro";
import Btn from "./ui/Btn.astro";

interface Mode {
  value: string;
  title: string;
  note: string;
  checked?: boolean;
}
interface Props {
  modes?: Mode[];
  start?: string;
  vehicles?: string[];
  seats?: string[];
  seatsSelected?: string;
  notes?: string;
  cta?: string;
}
const {
  modes = [
    { value: "needs_pickup", title: "Need a pickup", note: "Match me with a car", checked: true },
    { value: "driving", title: "Driving", note: "I can take others" },
    { value: "own_way", title: "Own way", note: "I’ll reach the base myself" },
  ],
  start = "5th block, Koramangala",
  vehicles = ["Car — 5 seats", "Car — 3 seats", "Bike — 1 pillion"],
  seats = ["0", "1", "2", "3", "4"],
  seatsSelected = "3",
  notes = "Sri Harsha and I are starting from the same location.",
  cta = "Save travel plan",
} = Astro.props;
---

<form class="card carpool-form">
  <div class="mode-row" role="radiogroup" aria-label="Travel mode">
    {modes.map((m) => (
      <label class="mode-card">
        <input type="radio" name="mode" value={m.value} checked={m.checked} />
        <strong>{m.title}</strong>
        <span>{m.note}</span>
      </label>
    ))}
  </div>

  <Field id="cp-start" label="Starting from">
    <input id="cp-start" type="text" value={start} />
  </Field>

  <label class="check">
    <input type="checkbox" checked />
    <span>Pick me up from where I start</span>
  </label>

  <div class="field-row">
    <Field id="cp-vehicle" label="Vehicle">
      <select id="cp-vehicle">
        {vehicles.map((v) => <option>{v}</option>)}
      </select>
    </Field>
    <Field id="cp-seats" label="Seats you can offer">
      <select id="cp-seats">
        {seats.map((s) => <option selected={s === seatsSelected}>{s}</option>)}
      </select>
    </Field>
  </div>

  <Field id="cp-notes" label="Notes for the organiser">
    <textarea id="cp-notes" rows="2">{notes}</textarea>
  </Field>

  <Btn variant="primary" type="button">{cta}</Btn>
</form>
