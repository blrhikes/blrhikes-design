---
/* EventTicket — the dense list row: a tear-off date stub, the essentials,
   and a chevron. No photo, so many fit on a screen. */
import Pill from "../ui/Pill.astro";
import IconLine from "../ui/IconLine.astro";

interface Props {
  ticket: any;
}
const { ticket } = Astro.props;
---

<article class="card ticket-row">
  <div class="ticket-stub">
    <span class="mon">{ticket.stub.mon}</span><span class="day">{ticket.stub.day}</span><span class="dow">{ticket.stub.dow}</span><span class="time">{ticket.stub.time}</span>
  </div>
  <div class="ticket-body">
    <h4 class="title" style="font-size:1.05rem">{ticket.name}</h4>
    <IconLine icon="location-dot">{ticket.where}</IconLine>
    <div class="ticket-tags">
      {ticket.tags.map((t: any) => <Pill variant={t.variant}>{t.text}</Pill>)}
    </div>
  </div>
  <div class="ticket-chev"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></div>
</article>
