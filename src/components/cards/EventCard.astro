---
/* EventCard — photo on top with the title and DateBlock riding on it, facts
   and attendees below. The three-up/two-up workhorse. */
import PhotoWrap from "../ui/PhotoWrap.astro";
import DateBlock from "../ui/DateBlock.astro";
import Pill from "../ui/Pill.astro";
import IconLine from "../ui/IconLine.astro";
import AttendeeFaces from "../ui/AttendeeFaces.astro";
import PillLead from "../ui/PillLead.astro";
import Btn from "../ui/Btn.astro";

interface Props {
  event: any;
}
const { event } = Astro.props;
---

<article class="card photo-card">
  <PhotoWrap photo={event.photo}>
    <div class="photo-title">
      <h3 class="title">{event.name}</h3>
      <p class="photo-date">{event.start}</p>
    </div>
    <div class="photo-dateblock"><DateBlock {...event.date} label={event.dateLabel} /></div>
    <span class="photo-badge"><Pill variant={event.badge.variant}>{event.badge.text}</Pill></span>
  </PhotoWrap>
  <div class="photo-body">
    <div class="cluster">
      {event.pills.map((p: any) => <Pill variant={p.variant} icon={p.icon}>{p.text}</Pill>)}
    </div>
    <IconLine icon="location-dot">{event.where}</IconLine>
    <p class="fine clamp-2">{event.blurb}</p>
    {/* Who is leading and who is going, on one line — the pair the prominent
        card and the registration card both carry, in the same shape. A cluster
        rather than two blocks, so on a narrow column they wrap instead of
        taking a row each. */}
    <div class="cluster">
      {event.lead && <PillLead initials={event.lead.initials}>Led by {event.lead.name}</PillLead>}
      <AttendeeFaces as="span" {...event.going} />
    </div>
    <div class="card-foot">
      <IconLine icon="clock" regular as="span">{event.start}</IconLine>
      <span class="actions">
        {event.actions.map((a: any) => (
          <Btn variant={a.variant} size="sm" href="#">{a.text}</Btn>
        ))}
      </span>
    </div>
  </div>
</article>
