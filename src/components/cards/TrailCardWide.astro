---
/* TrailCardWide — TrailCard with room for the blurb and the route links.
   Two up; the rip runs along the top and bottom ends. */
import PhotoWrap from "../ui/PhotoWrap.astro";
import Pill from "../ui/Pill.astro";
import Rating from "../ui/Rating.astro";
import IconLine from "../ui/IconLine.astro";
import TrailStats from "../ui/TrailStats.astro";
import HighlightTags from "../ui/HighlightTags.astro";
import TrailLinks from "../ui/TrailLinks.astro";

interface Props {
  trail: any;
}
const { trail } = Astro.props;
---

<article class="card photo-card trail-card-wide">
  <PhotoWrap photo={trail.photo} alt={trail.alt}>
    {trail.badge && (
      <span class="photo-badge"><Pill variant={trail.badge.variant}>{trail.badge.text}</Pill></span>
    )}
  </PhotoWrap>
  <div class="photo-body">
    <div class="photo-toprow">
      <Pill variant={trail.gradeVariant}>{trail.grade}</Pill>
      <Rating value={trail.rating} />
    </div>
    <h3 class="title">{trail.name}</h3>
    <IconLine icon="location-dot">{trail.where}</IconLine>
    <p class="fine">{trail.blurb}</p>
    <TrailStats stats={trail.stats} />
    <HighlightTags tags={trail.tags} />
    <TrailLinks start={trail.start} map={trail.map} slug={trail.slug} />
  </div>
</article>
