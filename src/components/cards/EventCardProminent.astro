---
/* EventCardProminent — the lead event: wide cover, DateBlock beside the
   title, attendees and price in the foot. `tear: "sides"` swaps the rip from
   the top/bottom ends to the left/right sides (the -TornSides variant). */
import PhotoWrap from "../ui/PhotoWrap.astro";
import DateBlock from "../ui/DateBlock.astro";
import Pill from "../ui/Pill.astro";
import PillLead from "../ui/PillLead.astro";
import IconLine from "../ui/IconLine.astro";
import AttendeeFaces from "../ui/AttendeeFaces.astro";
import Btn from "../ui/Btn.astro";

interface Props {
  event: any;
  tear?: "ends" | "sides";
  /** The event page. Given, the PHOTO becomes an overlay anchor and the
      TITLE a plain link (owner, 2026-08-10) — deliberately not the trail
      cards' stretched .photo-link, whose whole-card cover would swallow the
      Details/Register buttons in the foot. */
  href?: string;
}
const { event, tear = "ends", href } = Astro.props;
---

<article class:list={["card", "feat-card", tear === "sides" && "torn-lr"]}>
  <PhotoWrap photo={event.photo}>
    <span class="photo-badge"><Pill variant={event.badge.variant}>{event.badge.text}</Pill></span>
    {/* The place belongs on the picture: it says where the picture IS, and it
        frees the body to open on the title. */}
    {/* An on-photo PILL, not bare white type (owner, 2026-08-08) — the same
        frosted chip the trail overlay card wears, so every fact sitting on a
        photograph speaks in one voice. .photo-meta only places it now. */}
    <p class="photo-meta"><Pill variant="on-photo" icon="location-dot">{event.where}</Pill></p>
    {href && <a class="photo-door" href={href} aria-label={event.name}></a>}
  </PhotoWrap>
  <div class="feat-body">
    <div class="feat-head">
      <DateBlock {...event.date} label={event.dateLabel} />
      <div>
        <h3 class="title feat-title">{href ? <a class="title-link" href={href}>{event.name}</a> : event.name}</h3>
        <IconLine icon="clock" regular>{event.time}</IconLine>
      </div>
    </div>
    <p class="fine clamp-2">{event.blurb}</p>
    <div class="cluster">
      <Pill icon={event.kind.icon}>{event.kind.text}</Pill>
      <PillLead initials={event.lead.initials}>Led by {event.lead.name}</PillLead>
      <AttendeeFaces as="span" {...event.going} />
    </div>
    <div class="card-foot">
      <p class="price">{event.price}</p>
      <span class="actions">
        <Btn variant="secondary" size="sm" href="/event/">Details</Btn>
        <Btn variant="primary" size="sm" href="#">Register</Btn>
      </span>
    </div>
  </div>
</article>
