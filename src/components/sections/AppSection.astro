---
/* App surfaces — components that travelled the OTHER way: born in
   blrhikes-app, ported into the canon so the two stop drifting. The header
   every page opens with, and the panel that closes the home page. */
import SectionHead from "../ui/SectionHead.astro";
import Spec from "../ui/Spec.astro";
import Btn from "../ui/Btn.astro";
import Pill from "../ui/Pill.astro";
import PageHeader from "../PageHeader.astro";
import CtaPanel from "../CtaPanel.astro";
import TrailHero from "../TrailHero.astro";
import StatBand from "../ui/StatBand.astro";
import PaperStack from "../PaperStack.astro";
import StatStrip from "../StatStrip.astro";
import ActionTile from "../ActionTile.astro";
import GateNote from "../GateNote.astro";
import EateryList from "../EateryList.astro";
import TrailCardProminent from "../cards/TrailCardProminent.astro";
import { cover } from "../../data/images.js";
import { trailCardsOverlay } from "../../data/trails.js";
---

<section class="section" id="app">
  <div class="container">
    <SectionHead eyebrow="08 · App surfaces" title="The app's own furniture">
      Ported <em>from</em> the app rather than to it — the surfaces every page
      shares, now spec'd here so there is one answer to what they look like.
    </SectionHead>

    <Spec doc="PageHeader">PageHeader — crumbs, kicker, title, actions on one baseline</Spec>
    <PageHeader
      crumbs={[{ label: "Events", href: "#" }, { label: "Skandagiri Sunrise Hike" }]}
      kicker="Upcoming hike"
      title="Skandagiri Sunrise Hike"
      sub="Sat 8 Aug · 04:30 at the base · 6 of 25 spots left"
    >
      {/* The slot rides a Fragment, not the Btn: Btn spreads its rest props,
          so `slot="actions"` on it would land in the DOM as an attribute. */}
      <Fragment slot="actions">
        <Btn variant="secondary" size="sm" href="#">Manage event</Btn>
      </Fragment>
    </PageHeader>

    <Spec gap doc="CtaPanel">CtaPanel — the inverted sell, one action</Spec>
    <CtaPanel
      title="Adventure awaits"
      blurb="Membership unlocks the exact locations, GPX files and access notes for every documented trail — and gets you first pick of the trips."
      cta="What membership unlocks"
      href="#"
    />

    <Spec gap doc="TrailHero">TrailHero — the trail page's opening, EventCover's family</Spec>
    <TrailHero
      photo={cover("63972ac0-b799-418f-991f-0fd3c921601e")}
      alt="Mouth of the immovable rock cave"
      backHref="#"
      backLabel="All trails"
      title="Immovable Rock Cave"
      sub="Ramanagara · south-west of Bengaluru"
      flush={false}
    >
      <p><Pill variant="on-photo">draft</Pill></p>
    </TrailHero>

    <Spec gap doc="StatStrip">StatStrip — the secondary numbers, one quiet row</Spec>
    <StatStrip
      stats={[
        { n: "2.4", u: "km", l: "Trail length" },
        { n: "124", u: "m", l: "Elevation gain" },
        { n: "1–2 h", l: "Hiking time" },
        { n: "1 h 08 · 54 km", l: "Drive from the city" },
      ]}
    />

    <Spec gap doc="ActionTile">ActionTile — the ways into the field, one inert</Spec>
    <div class="action-tiles">
      <ActionTile label="Trek start" icon="location-dot" note="Opens in Google Maps" href="#" />
      <ActionTile label="Trail map" icon="map-location-dot" note="Route, with a note on offline use" href="#" />
      <ActionTile label="GPX file" icon="download" note="Not uploaded for this trail yet." disabled />
      <ActionTile label="Check the weather" icon="cloud-sun-rain" note="Forecast for this spot" href="#" />
    </div>

    <Spec gap doc="GateNote">GateNote — the members gate, kept warm</Spec>
    <GateNote>
      The trek start location, trail map and weather link are member perks — they keep fragile places from getting mobbed.
      <Fragment slot="cta"><Btn variant="primary" size="sm" href="#">What membership unlocks</Btn></Fragment>
    </GateNote>

    <Spec gap doc="EateryList">EateryList — food stops, addresses open</Spec>
    <EateryList
      eateries={[
        {
          name: "Sri Ganesha Tiffin Room",
          veg: true,
          toilet: "Usable toilet",
          address: "SH-17, opposite the bus stand, Harohalli",
          addressHref: "#",
          blurb: "Idli–vada from six; the filter coffee is the reason to stop.",
        },
        {
          name: "Highway Dhaba",
          veg: false,
          toilet: "No toilet",
          blurb: "Late breakfast on the way back.",
        },
      ]}
    />

    <Spec gap doc="EateryList">EateryList — the same stops behind the gate</Spec>
    <EateryList
      locked
      eateries={[
        {
          name: "Sri Ganesha Tiffin Room",
          veg: true,
          toilet: "Usable toilet",
          address: "SH-17, opposite the bus stand, Harohalli",
          addressHref: "#",
        },
      ]}
    />

    <Spec gap doc="StatBand">StatBand — `plain`, riding a card that is the paper</Spec>
    <section class="card" style="padding:1.5rem">
      <StatBand plain stats={[["Open access", "No permit required"], ["Easy", "Difficulty"], ["4.5/5", "Rating"]]} />
    </section>

    <Spec gap doc="PaperStack">PaperStack — two torn sheets, on purpose</Spec>
    <PaperStack>
      <StatBand plain stats={[["48", "Documented trails"], ["12", "With caves"], ["31", "Under 2 h away"]]} />
    </PaperStack>

    <Spec gap doc="TrailCardProminent">TrailCardProminent — the trail at the lead event's size</Spec>
    <TrailCardProminent trail={trailCardsOverlay[0]} />
  </div>
</section>
