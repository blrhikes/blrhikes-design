---
/* Every page: the token contract, all nineteen themes, the paper filters and
   the top bar. Mirrors the app's design-system rule — components paint from a
   token contract, a theme is one file that re-points the tokens — so this
   layout imports base.css first and the themes after it, and nothing in
   base.css knows themes exist. */
import PaperFilters from "../components/PaperFilters.astro";
import TopBar from "../components/TopBar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import {
  themes,
  defaultTheme,
  storageKey,
  shadowKey,
  themeParam,
  shadowParam,
} from "../data/themes.js";

/* The inline script below cannot import, so the roster it validates against is
   handed to it — an unknown ?theme= must not reach `data-theme`, or the page
   paints with no theme at all. */
const themeIds = themes.map((t) => t.id);

import "../styles/base.css";
import "../styles/themes/kraft.css";
/* After kraft.css, which declares the palette for Kraft AND Kraft Gold — the
   file below is only the accent that differs, and it wins on order, not on
   specificity. Kraft Canopy is a whole theme file and merely keeps the
   company. */
import "../styles/themes/kraft-gold.css";
import "../styles/themes/kraft-canopy.css";
import "../styles/themes/contour.css";
import "../styles/themes/monsoon.css";
import "../styles/themes/poster.css";
import "../styles/themes/hivis.css";
import "../styles/themes/solstice-day.css";
import "../styles/themes/solstice-night.css";
import "../styles/themes/bluebird.css";
import "../styles/themes/canopy.css";
import "../styles/themes/mono.css";
import "../styles/themes/canopy-day.css";
import "../styles/themes/milestone.css";
/* After milestone.css, which declares the palette for both — this file is the
   one token that differs, and it wins on order, not on specificity. */
import "../styles/themes/milestone-soft.css";
import "../styles/themes/kraft-night.css";
import "../styles/themes/milestone-night.css";
import "../styles/themes/stargazing.css";
import "../styles/themes/solstice-stars.css";

/* After every theme, so a theme cannot out-order the shared tear geometry. */
import "../styles/torn-paper.css";

/* Last of all: the shadow override has to outrank every theme's own lift, and
   it does it on order rather than on specificity. */
import "../styles/shadow-toggle.css";

interface Props {
  title: string;
  links: { href: string; label: string; current?: boolean }[];
  brandHref?: string;
  themePicker?: boolean;
  mainId?: string;
  footer?: "band" | "quiet" | "none";
  footerNote?: string;
}
const {
  title,
  links,
  brandHref,
  themePicker,
  mainId,
  footer = "band",
  footerNote,
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    <!-- Applied before first paint so there is no theme flash. The shadow
         override rides along: it is a second attribute on the same element,
         and a card that painted lifted and then flattened a frame later would
         be exactly the flash this script exists to prevent.

         The query string outranks localStorage — a link that says which theme
         to show has to win over what this browser last picked, or it isn't a
         link to anything. Both settings are then stored, so the choice
         survives the next click the way the picker's does. -->
    <script
      is:inline
      define:vars={{ storageKey, shadowKey, themeParam, shadowParam, themeIds }}
    >
      try {
        var root = document.documentElement;
        var qs = new URLSearchParams(location.search);

        /* Storage throws outright in some privacy modes; a link should still
           work there, so every touch of it is swallowed on its own rather than
           taking the URL down with it. */
        var get = function (k) {
          try {
            return localStorage.getItem(k);
          } catch (e) {
            return null;
          }
        };
        var put = function (k, v) {
          try {
            localStorage.setItem(k, v);
          } catch (e) {}
        };

        /* An unknown id would leave the page with no theme's tokens at all, so
           a param that names one is discarded — and discarded back to what was
           stored, since a typo in a link is no reason to also forget the
           browser's own choice. */
        var t = qs.get(themeParam);
        if (!t || themeIds.indexOf(t) === -1) t = get(storageKey);
        if (t && themeIds.indexOf(t) !== -1) {
          root.dataset.theme = t;
          put(storageKey, t);
        }

        /* `theme` is the URL's word for the default mode; the stored form of
           it is the empty string, and neither writes an attribute. Same
           fallback as above for anything else. */
        var s = qs.get(shadowParam);
        if (s === "theme") s = "";
        else if (s !== "on" && s !== "off") s = get(shadowKey);

        if (s === "on" || s === "off") {
          root.dataset.shadows = s;
          put(shadowKey, s);
        } else if (s === "") {
          put(shadowKey, "");
        }
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=DM+Sans:opsz,wght@9..40,400..500&family=IBM+Plex+Sans+Condensed:wght@500;600&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..500&family=Mulish:wght@400..600&family=Anton&family=Karla:ital,wght@0,400..700;1,400&family=Archivo:ital,wdth,wght@0,62..125,400..800;1,62..125,400..700&family=Chivo+Mono:wght@400;500&family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Sans:ital,wght@0,400..600&family=Lora:ital,wght@0,400..600;1,400..500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <slot name="head" />
  </head>
  <body>
    <PaperFilters />
    <slot name="filters" />

    <TopBar links={links} brandHref={brandHref} themePicker={themePicker} />

    <main id={mainId}>
      <slot />
    </main>

    {footer !== "none" && (
      <SiteFooter variant={footer}>
        <Fragment set:html={footerNote} />
      </SiteFooter>
    )}

    <slot name="after" />

    {/* Astro hoists and bundles these once; each module no-ops on the pages
        whose markup it does not find. */}
    <script>
      import "../scripts/theme.js";
      import "../scripts/pagenav.js";
      import "../scripts/htags.js";
      import "../scripts/nav-drawer.js";
      import "../scripts/debug.js";
    </script>
  </body>
</html>
