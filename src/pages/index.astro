---
/* The showcase: the same set of real components rendered under fifteen
   interchangeable themes. Every band is its own section component. */
import BaseLayout from "../layouts/BaseLayout.astro";
import PageNav from "../components/PageNav.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import PaletteSection from "../components/sections/PaletteSection.astro";
import TypeSection from "../components/sections/TypeSection.astro";
import ComponentsSection from "../components/sections/ComponentsSection.astro";
import EventSurfacesSection from "../components/sections/EventSurfacesSection.astro";
import CarpoolSection from "../components/sections/CarpoolSection.astro";
import TrailsSection from "../components/sections/TrailsSection.astro";
import EdgesSection from "../components/sections/EdgesSection.astro";
import AppSection from "../components/sections/AppSection.astro";
import { showcaseLinks } from "../data/nav.js";
---

<BaseLayout
  title="BLR Hikes — theme explorations"
  links={showcaseLinks}
  themePicker
  mainId="top"
  footerNote="Theme explorations · fifteen skins over one token contract · content &amp; images from the app’s seed data · themes via the paint-roller, or the number row and the punctuation keys after it"
>
  <HeroSection />
  <PaletteSection />
  <TypeSection />
  <ComponentsSection />
  <EventSurfacesSection />
  <CarpoolSection />
  <TrailsSection />
  <EdgesSection />
  <AppSection />

  <PageNav slot="after" />
</BaseLayout>
